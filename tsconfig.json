{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true
    },
    "files": [],
    "include": [],
    "references": [
        {
            "path": "./packages/sdk"
        },
        {
            "path": "./packages/agent"
        },
        {
            "path": "./packages/cli"
        },
        {
            "path": "./packages/mcp"
        },
        {
            "path": "./apps/web"
        }
    ]
}
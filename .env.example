# Deployer Keys (TESTNET)
# CAUTION: NEVER commit real funds private keys. Use separate deployer accounts.
DEPLOYER_SECRET_KEY=S...

# Contract IDs (Populated after deployment)
NEXT_PUBLIC_CONTRACT_IDENTITY_POOL=
NEXT_PUBLIC_CONTRACT_PAYMENT_GATE=
NEXT_PUBLIC_CONTRACT_SENTINEL=
NEXT_PUBLIC_CONTRACT_VERIFIER=

# Network Configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Fee Sponsorship
# Private key for the account paying for user's gas (Fee Bumps)
NEXT_PUBLIC_FEE_SPONSOR_SK=S...

# RPC/API Keys (If using QuickNode, etc.)
RPC_API_KEY=

# --- NIRIUM SHOWROOM .gitignore --- (BSL 1.1 Public Distribution)

# Node/PNPM
node_modules/
.npmrc
pnpm-lock.yaml
package-lock.json

# Build / Transpiled
dist/
build/
target/
.vercel
.next/
out/
*.tsbuildinfo

# ══════════════════════════════════════════════════
# SECRETOS — NUNCA DEBEN APARECER EN EL SHOWROOM
# ══════════════════════════════════════════════════
.env
.env.*
*.env
*.env.local
.env.local
.contract-ids.env
central_issuer.json
packages/agent/.env
apps/web/.env.local

# 21-ago-2026: orphaned debug scripts with a hardcoded Etherfuse sandbox
# key as fallback default, never present in the current private source,
# invisible to the sync whitelist -- nobody was reviewing them. Removed;
# rule kept so a stale branch can't silently reintroduce them.
apps/web/test-etherfuse.js
apps/web/test-quote.js

# Python venv accidentally tracked before this rule existed (git doesn't
# retroactively apply gitignore to already-tracked paths). No secrets in
# it, just hygiene -- matches the venv/ rule already in the private repo.
venv/
**/venv/

# ══════════════════════════════════════════════════
# LOGICA PROPIETARIA — PROTEGIDA (STUBS EN SU LUGAR)
# ══════════════════════════════════════════════════
packages/agent/src/services/swarm/
packages/agent/src/execution/executeStrategy.ts
packages/agent/src/providers/llm/
packages/agent/scripts/
scripts/surgical_filter.sh
scripts/public_export.sh

# ══════════════════════════════════════════════════

{
  "name": "Nirium Agentic Hub",
  "description": "Premium institutional-grade AI signals and strategy execution on Stellar.",
  "version": "1.0.0",
  "provider": "Nirium Protocol Architects",
  "stellar": {
    "network": "stellar:testnet",
    "recipient": "GDZ...YOUR_RECIPIENT_ADDRESS..."
  },
  "endpoints": [
    {
      "path": "/api/v1/premium/signals",
      "method": "GET",
      "description": "Real-time high-fidelity market arbitrage signals.",
      "price": "$0.01",
      "scheme": "exact"
    },
    {
      "path": "/api/v1/premium/audit",
      "method": "POST",
      "description": "Agent-to-Agent security audit for Soroban strategy execution.",
      "price": "$0.05",
      "scheme": "exact"
    },
    {
      "path": "/api/v1/premium/execute",
      "method": "POST",
      "description": "Trigger autonomous execution matrix for a specific strategy.",
      "price": "$0.05",
      "scheme": "exact"
    }
  ],
  "mpp": {
    "charge": true,
    "channel": true,
    "discovery": "/api/v1/mpp/info"
  }
}
